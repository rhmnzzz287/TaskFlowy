{
  "name": "taskflowy-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:push": "drizzle-kit push",
    "auth:generate": "npx @better-auth/cli generate --output src/db-schema.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "better-auth": "^1.7.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "20.19.43",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "esbuild@0.28.2": true
  }
}
