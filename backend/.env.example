# --- server ---
PORT=8000

# --- better-auth ---
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-min-32-chars-long-secret
# This server's own base URL (used for absolute links/redirects).
BETTER_AUTH_URL=http://localhost:8000

# --- database (SQLite file, zero-config local dev) ---
# DATABASE_URL=postgresql://user:password@host:5432/db
DATABASE_URL=file:./data/taskflowy.db

# --- frontend origins allowed to call this server (comma-separated) ---
TRUSTED_ORIGINS=http://localhost:3000
